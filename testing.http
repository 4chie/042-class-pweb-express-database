@baseUrl = http://localhost:3000

### 1. GET semua produk -> 200 + array
GET {{baseUrl}}/products

### 2. GET produk id 1 -> 200 + objek produk
GET {{baseUrl}}/products/1

### 3. GET produk tidak ada -> 404
GET {{baseUrl}}/products/999

### 4. POST produk baru -> 201 + produk dengan id baru
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Penggaris",
  "price": 7000
}

### 5. POST data tidak valid -> 400
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "",
  "price": "abc"
}

### 6. PUT ubah produk (body sama dengan POST + id) -> 200 + produk terbaru
PUT {{baseUrl}}/products
Content-Type: application/json

{
  "id": 1,
  "name": "Buku Tulis",
  "price": 12000
}

### 7. PUT id tidak ada -> 404
PUT {{baseUrl}}/products
Content-Type: application/json

{
  "id": 999,
  "name": "Tidak Ada",
  "price": 1000
}

### 8. PUT data tidak valid (tanpa id) -> 400
PUT {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Tanpa Id",
  "price": 1000
}

### 9. DELETE produk id 2 -> 200 + pesan berhasil
DELETE {{baseUrl}}/products/2

### 10. DELETE id tidak ada -> 404
DELETE {{baseUrl}}/products/999
